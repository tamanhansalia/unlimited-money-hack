{
  "name": "2pixelhack",
  "productName": "2PixelHack",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop workspace for cutting, reviewing, and publishing vertical clips",
  "main": "src/main/index.js",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "app-icon": "electron scripts/build-app-icon.js",
    "prebuild": "node scripts/build-icons.mjs",
    "build": "vite build",
    "dev": "npm start",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.2pixelhack.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "resources/icon.ico",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/autoclipper.py",
        "to": "engine/autoclipper.py"
      },
      {
        "from": "../engine/clip_ai.py",
        "to": "engine/clip_ai.py"
      },
      {
        "from": "../engine/generation_options.py",
        "to": "engine/generation_options.py"
      },
      {
        "from": "../engine/playbook.py",
        "to": "engine/playbook.py"
      },
      {
        "from": "../engine/finder.py",
        "to": "engine/finder.py"
      },
      {
        "from": "../engine/subtitle_render.py",
        "to": "engine/subtitle_render.py"
      },
      {
        "from": "../engine/generation-presets.json",
        "to": "engine/generation-presets.json"
      },
      {
        "from": "../engine/fonts",
        "to": "engine/fonts"
      }
    ],
    "mac": {
      "icon": "resources/icon.png"
    },
    "win": {
      "icon": "resources/icon.ico"
    }
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  }
}
